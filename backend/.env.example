# ---- Database (PostgreSQL) ----
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/ekart

# ---- Security ----
# Use a long random string in production (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=10080

# ---- URLs ----
FRONTEND_URL=http://localhost:5173
# Public URL of this API. Cashfree webhooks need HTTPS (use your domain or an ngrok URL in dev).
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# ---- First admin account (created by `python -m app.seed`) ----
ADMIN_EMAIL=admin@ekart.shop
ADMIN_PASSWORD=admin123

# ---- Cashfree Payment Gateway ----
# Leave APP_ID / SECRET_KEY empty to use built-in TEST MODE (simulated payments).
# Get keys: Cashfree Merchant Dashboard -> Developers -> API Keys
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# ---- Delivery partner ----
# "manual"     = admin enters the courier's AWB/tracking number by hand.
# "shiprocket" = book shipments through Shiprocket (manual entry stays available as a fallback).
SHIPPING_PROVIDER=manual
# Shared secret for delivery status updates. In Shiprocket: Settings -> API -> Webhooks,
# URL = https://<your-domain>/api/shipping/webhook , Token = this value.
SHIPPING_WEBHOOK_SECRET=change-this-webhook-secret

# ---- Shiprocket ----
# Create a separate API user: Shiprocket panel -> Settings -> API -> Create API User.
# Use that API user's email/password here (NOT your main Shiprocket login).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact name of your pickup address in Shiprocket (Settings -> Pickup Addresses), e.g. Primary
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: PIN code of that pickup address (looked up automatically if empty)
SHIPROCKET_PICKUP_PINCODE=
